{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xtremetyler/yugifaux-duelingbook-companion/main/config/companion.schema.json",
  "title": "YugiFaux Companion configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataVersion", "minimumCoreVersion", "featureFlags", "allowedAssetHosts", "animations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "dataVersion": { "type": "string", "minLength": 1 },
    "minimumCoreVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "featureFlags": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "allowedAssetHosts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "presentation", "frequency"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eventType", "cardName"],
            "properties": {
              "eventType": { "enum": ["effect-declaration", "normal-summon", "special-summon", "fusion-summon", "synchro-summon", "xyz-summon", "link-summon", "activation", "attack"] },
              "cardName": { "type": "string", "minLength": 1 }
            }
          },
          "presentation": {
            "type": "object",
            "required": ["title", "durationMs"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "subtitle": { "type": "string" },
              "theme": { "type": "string" },
              "preset": { "enum": ["title-card-v1", "petal-bloom-v1"] },
              "accentColor": { "type": "string" },
              "durationMs": { "type": "integer", "minimum": 500, "maximum": 8000 },
              "assetUrl": { "type": ["string", "null"] },
              "audioUrl": { "type": ["string", "null"] }
            }
          },
          "frequency": { "enum": ["once-per-duel", "every-event"] }
        }
      }
    }
  }
}
