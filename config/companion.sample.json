{
  "$schema": "./companion.schema.json",
  "schemaVersion": 1,
  "dataVersion": "poc-2026-08-26.5",
  "minimumCoreVersion": "0.4.0",
  "featureFlags": {
    "panel": true,
    "eventObserver": true,
    "animations": true
  },
  "allowedAssetHosts": [
    "raw.githubusercontent.com",
    "res.cloudinary.com"
  ],
  "animations": [
